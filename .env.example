# ---------------------------- ЛЭРС УЧЁТ ----------------------------
LERS_BASE_URL=http://109.201.97.4:10000
# Ключ приложения: карточка пользователя -> вкладка "Приложения" -> создать
LERS_API_KEY=
# Резервный вариант, если ключ ещё не выпущен
LERS_LOGIN=api
LERS_PASSWORD=
LERS_TIMEOUT=60
LERS_CONNECT_TIMEOUT=10
LERS_CONCURRENCY=4
# Ретраи на 429/5xx/таймаут: число попыток и базовая пауза (удваивается)
LERS_RETRIES=4
LERS_RETRY_BASE_DELAY=1.0
# Проверять TLS-сертификат сервера ЛЭРС (по умолчанию выкл. для http/самоподписанных)
LERS_VERIFY_SSL=false

# ------------------------------- 1С -------------------------------
# manual | odata | http
ONEC_MODE=manual
ONEC_BASE_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_TIMEOUT=120
ONEC_ODATA_RESOURCE=AccumulationRegister_Затраты/Turnovers
ONEC_FIELD_OBJECT=Объект
ONEC_FIELD_AMOUNT=СуммаОборот
ONEC_HTTP_PATH=/hs/costs/period
ONEC_MANUAL_FILE=data/costs.xlsx

# ------------------------------ MAX -------------------------------
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_TIMEOUT=60
# Проверка TLS-сертификата MAX. Сертификат *.max.ru выпущен Russian Trusted CA
# (Минцифры) — его нет в certifi, поэтому доверенные корни лежат в data/certs.
MAX_VERIFY_SSL=true
MAX_CA_BUNDLE=data/certs
# Куда бот сам присылает отчёты по расписанию (через запятую)
MAX_BROADCAST_CHAT_IDS=
# Кому разрешено запрашивать отчёты вручную (пусто = всем)
MAX_ALLOWED_USER_IDS=
# Пауза после загрузки файла перед отправкой, c (обход attachment.not.ready)
MAX_UPLOAD_SETTLE=3.0
# Ретраи на 429/5xx/таймаут и число повторов отправки вложения
MAX_RETRIES=4
MAX_RETRY_BASE_DELAY=1.0
MAX_ATTACHMENT_RETRIES=4

# ----------------------------- Отчёт ------------------------------
GAS_CALORIFIC_KCAL=8200
EFFICIENCY_THRESHOLD=80
POINTS_FILE=data/points.xlsx
OUTPUT_DIR=out

# ---------------------------- Состояние ---------------------------
# SQLite: суточные записи, дедуп рассылки, время последнего опроса
DB_PATH=data/archive.sqlite3

# --------------------------- Расписание ---------------------------
TZ_NAME=Europe/Moscow
WEEKLY_DAY=mon
WEEKLY_HOUR=7
MONTHLY_DAY=5
MONTHLY_HOUR=8
LOG_LEVEL=INFO
